# Скопируйте этот файл в .env и заполните значения:
# cp .env.example .env

# API ключ для LLM-аналитика (опционально)
# Без этого ключа dashboard работает в rule-based режиме
OPENAI_API_KEY=

# Кастомный OpenAI-совместимый endpoint (опционально)
# Если не задан — используется api.openai.com
# Примеры: https://api.odirouter.ai/v1
#          https://llm.lambda.coredump.ru/v1
LLM_BASE_URL=https://api.odirouter.ai/v1

# Модель (опционально, по умолчанию gpt-4o-mini)
# Для odirouter: grok-4.5 (платная) или free-grok-4.5 (лимит 5 запросов/мин)
OPENAI_MODEL=grok-4.5

# PEM-бандл с корневым CA «Russian Trusted Root CA» (Минцифры) для roskazna.gov.ru.
# Нужен, чтобы проверять TLS-сертификат источника, а не отключать проверку.
# По умолчанию берётся certs/russian_trusted_root_ca.pem — см. certs/README.md
# ROSKAZNA_CA_BUNDLE=

# АВАРИЙНЫЙ РЕЖИМ для roskazna.gov.ru: цепочка доверия не проверяется, сертификат
# сверяется по SHA-256 отпечатку. Нужен, пока у источника истёк сертификат
# (истёк 28.07.2026) и штатная проверка невозможна.
# Подмена на другой сертификат отбивается, но срок действия и отзыв не проверяются.
# Снимите переменную, как только Казначейство перевыпустит сертификат.
# Отпечаток на 30.07.2026 (сверьте сами перед использованием):
#   echo | openssl s_client -connect roskazna.gov.ru:443 -servername roskazna.gov.ru \
#     | openssl x509 -outform DER | openssl dgst -sha256
# ROSKAZNA_PINNED_CERT_SHA256=9616838add178517d2bd52aeaecd5ffdd69282c81d0e0c0584795f5a240c1a41
