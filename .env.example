# Скопируйте этот файл в .env и заполните значения:
# cp .env.example .env

# API ключ для LLM-аналитика (опционально)
# Без этого ключа dashboard работает в rule-based режиме
OPENAI_API_KEY=

# Кастомный OpenAI-совместимый endpoint (опционально)
# Если не задан — используется api.openai.com
# Примеры: https://api.odirouter.ai/v1
#          https://llm.lambda.coredump.ru/v1
LLM_BASE_URL=https://api.odirouter.ai/v1

# Модель (опционально, по умолчанию gpt-4o-mini)
# Для odirouter: grok-4.5 (платная) или free-grok-4.5 (лимит 5 запросов/мин)
OPENAI_MODEL=grok-4.5
